<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Runs every hour and syncs the connections with automatic sync whose
         next sync is due; the interval itself is set per connection. -->
    <record id="ir_cron_sync_connections" model="ir.cron">
        <field name="name">DF Connects: leverancierskoppelingen synchroniseren</field>
        <field name="model_id" ref="model_df_connects_connection"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
