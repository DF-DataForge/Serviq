<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Technical definition: refreshed on every module update. 'active'
         is not set here, so enabling / disabling the flow survives. -->
    <record id="flow_first_installation" model="serviq.portal.flow">
        <field name="name">Eerste installatie</field>
        <field name="code">first_installation</field>
        <field name="sequence">10</field>
        <field name="description">De installateur kiest het installatieproduct en het serienummer uit de voorraad van de distributeur; de installatie wordt aangemaakt met de componenten van de stuklijst en aan de interventie gekoppeld.</field>
        <field name="handler_model">serviq.portal.flow.handler.first_installation</field>
        <field name="template">serviq_flow_first_installation.flow_section</field>
        <field name="button_label">Installatie registreren</field>
        <field name="icon">fa-plus-circle</field>
        <field name="module">serviq_flow_first_installation</field>
    </record>
    <!-- Intervention types the flow is shown on: set on install only, then managed
         in Installaties > Configuratie > Flows. -->
    <data noupdate="1">
        <function model="serviq.portal.flow" name="write"
                  eval="[[ref('flow_first_installation')], {'intervention_type_ids': [(6, 0, [ref('serviq_installation.intervention_type_first_installation')])]}]"/>
    </data>
</odoo>
