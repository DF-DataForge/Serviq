<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal users see the logbook of their own installations and the
         cylinders of their own company (same scope as serviq_portal). -->
    <record id="rule_refrigerant_log_portal" model="ir.rule">
        <field name="name">Koudemiddellogboek: portaal ziet eigen installaties</field>
        <field name="model_id" ref="model_serviq_refrigerant_log"/>
        <field name="domain_force">['|',
            ('installation_id.distributor_id', 'child_of', [user.commercial_partner_id.id]),
            ('installation_id.installer_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_refrigerant_cylinder_portal" model="ir.rule">
        <field name="name">Koudemiddelfles: portaal ziet flessen van eigen bedrijf</field>
        <field name="model_id" ref="model_serviq_refrigerant_cylinder"/>
        <field name="domain_force">[('owner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_refrigerant_log_company" model="ir.rule">
        <field name="name">Koudemiddellogboek: multi-company</field>
        <field name="model_id" ref="model_serviq_refrigerant_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_refrigerant_cylinder_company" model="ir.rule">
        <field name="name">Koudemiddelfles: multi-company</field>
        <field name="model_id" ref="model_serviq_refrigerant_cylinder"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_refrigerant_cylinder_move_company" model="ir.rule">
        <field name="name">Beweging koudemiddelfles: multi-company</field>
        <field name="model_id" ref="model_serviq_refrigerant_cylinder_move"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
