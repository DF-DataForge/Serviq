<odoo>
    <record id="sn_registration_wizard_form" model="ir.ui.view">
        <field name="name">serviq.sn.registration.wizard.form</field>
        <field name="model">serviq.sn.registration.wizard</field>
        <field name="arch" type="xml">
            <form string="SN-registratie">
                <field name="installation_id" invisible="1"/>
                <field name="line_id" invisible="1"/>
                <field name="state" invisible="1"/>
                <field name="lot_id" invisible="1"/>
                <field name="photo_filename" invisible="1"/>

                <group>
                    <group>
                        <field name="product_tmpl_id"/>
                        <field name="rack_number" invisible="rack_number == 0"/>
                        <field name="distributor_id"/>
                        <field name="correct_location_id"/>
                        <field name="pending_count"/>
                        <field name="serial_number"
                               placeholder="Scan of typ het serienummer op de foto"/>
                    </group>
                    <group string="Serienummer foto">
                        <field name="photo" widget="image" nolabel="1"
                               readonly="1"
                               options="{'zoom': true, 'preview_image': 'photo', 'size': [0, 400]}"/>
                    </group>
                </group>

                <group string="Controles" invisible="state == 'draft'">
                    <group>
                        <field name="check_known"/>
                        <field name="check_in_customer_location"/>
                        <field name="check_correct_location"/>
                    </group>
                    <group>
                        <field name="current_location_id"
                               invisible="not current_location_id"/>
                    </group>
                </group>

                <div class="alert alert-success" role="alert"
                     invisible="state != 'ok'">
                    <field name="status_message" nolabel="1"/>
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="state not in ('unknown', 'wrong_location', 'no_stock')">
                    <field name="status_message" nolabel="1"/>
                </div>
                <div class="alert alert-danger" role="alert"
                     invisible="state not in ('internal', 'blocked')">
                    <field name="status_message" nolabel="1"/>
                </div>

                <footer>
                    <button name="action_check" string="Controleren"
                            type="object" class="btn-primary"/>
                    <button name="action_accept" string="Accepteren"
                            type="object" class="btn-success"
                            invisible="state != 'ok'"/>
                    <button name="action_create_serial"
                            string="SN aanmaken in klantlocatie"
                            type="object" class="btn-warning"
                            invisible="state not in ('unknown', 'no_stock')"/>
                    <button name="action_move_serial"
                            string="Verplaatsen naar juiste klantlocatie"
                            type="object" class="btn-warning"
                            invisible="state != 'wrong_location'"/>
                    <button name="action_skip" string="Overslaan"
                            type="object" class="btn-secondary"
                            invisible="pending_count &lt;= 1"/>
                    <button string="Sluiten" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
