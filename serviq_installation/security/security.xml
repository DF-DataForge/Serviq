<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_installation">
        <field name="name">Installaties</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_installation_user" model="res.groups">
        <field name="name">Gebruiker</field>
        <field name="comment">Gebruiker: beheert installaties en hun interventies.</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('project.group_project_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_installation"/>
    </record>

    <record id="group_installation_manager" model="res.groups">
        <field name="name">Beheerder</field>
        <field name="comment">Beheerder: beheert ook de configuratie (categorieën, rollen, types interventie, flows).</field>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_installation_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_installation"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="installation_company_rule" model="ir.rule">
        <field name="name">Installatie: multi-company</field>
        <field name="model_id" ref="model_serviq_installation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
