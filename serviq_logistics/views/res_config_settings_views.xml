<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_serviq_logistics" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.serviq.logistics</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Logistiek dashboards" name="serviq_logistics_setting_container">
                    <setting string="Leveranciers reserveonderdelen"
                             help="Beperk het dashboard Reserveonderdelen tot deze leveranciers (leeg = alle reserveonderdelen).">
                        <field name="serviq_spare_supplier_ids" widget="many2many_tags"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
