<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- One operation type as a card. Expects: step, variant -->
    <t t-name="serviq_logistics.StockFlowCard">
        <div t-attf-class="sq-sf-card sq-sf-card-{{ variant }}">
            <div class="sq-sf-kicker" t-esc="step.label"/>
            <a href="#" class="sq-sf-name" t-on-click.prevent="() => this.openStep(step, 'all')"
               title="Alle bewerkingen van deze soort" t-esc="step.name"/>
            <button type="button" class="btn btn-sm sq-sf-main" t-on-click="() => this.openStep(step, 'ready')">
                <t t-esc="step.main"/> <t t-esc="step.main_label"/>
            </button>
            <div class="sq-sf-stats">
                <t t-foreach="step.stats" t-as="stat" t-key="stat_index">
                    <a t-if="stat.value" href="#" class="sq-sf-stat" t-on-click.prevent="() => this.openStep(step, stat.filter)">
                        <t t-esc="stat.label"/> <t t-esc="stat.value"/>
                    </a>
                </t>
            </div>
        </div>
    </t>

    <t t-name="serviq_logistics.StockFlow">
        <div class="sq-sf-dashboard o_action">
            <div class="sq-dashboard-header">
                <div class="sq-header-title sq-header-brand">
                    <div>
                        <h2>Voorraadstroom</h2>
                        <div class="sq-header-subtitle">Bewerkingen per magazijn, van ontvangst tot levering en retour</div>
                    </div>
                </div>
                <div class="sq-header-controls">
                    <label class="mb-0 fw-semibold" for="sq_sf_warehouse">Magazijn</label>
                    <select id="sq_sf_warehouse" class="form-select form-select-sm sq-sf-select" t-on-change="onSelect">
                        <t t-foreach="state.warehouses" t-as="wh" t-key="wh.id">
                            <option t-att-value="wh.id" t-att-selected="state.selected === String(wh.id)" t-esc="wh.name"/>
                        </t>
                        <option value="all" t-att-selected="state.selected === 'all'">Alle magazijnen</option>
                    </select>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.reload()" title="Vernieuwen">
                        <i class="fa fa-refresh"/>
                    </button>
                </div>
            </div>

            <div class="sq-sf-body">
                <div t-if="state.loading" class="sq-loading">
                    <i class="fa fa-spinner fa-spin fa-2x"/><span class="ms-2">Voorraadstroom laden...</span>
                </div>
                <t t-else="">
                    <section t-foreach="shownWarehouses" t-as="wh" t-key="wh.id" class="sq-sf-wh">
                        <h3 class="sq-sf-wh-title" t-esc="wh.name"/>

                        <!-- Forward: receipt -> putaway -> stock -> picking -> packing -> delivery -->
                        <div class="sq-sf-row">
                            <t t-foreach="forward(wh)" t-as="item" t-key="item_index">
                                <div t-if="item_index" class="sq-sf-arrow" aria-hidden="true">
                                    <i class="fa fa-long-arrow-right"/>
                                </div>
                                <t t-if="item.role === 'stock'">
                                    <div class="sq-sf-card sq-sf-stock">
                                        <div class="sq-sf-kicker">Voorraad</div>
                                        <div class="sq-sf-name" t-esc="wh.stock.location || 'Voorraad'"/>
                                        <button type="button" class="btn btn-sm sq-sf-stock-btn" t-on-click="() => this.openStock(wh)">
                                            Voorraad bekijken
                                        </button>
                                        <div class="sq-sf-stats"><t t-esc="wh.stock.products"/> producten op voorraad</div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <t t-set="step" t-value="item"/>
                                    <t t-set="variant" t-value="'forward'"/>
                                    <t t-call="serviq_logistics.StockFlowCard"/>
                                </t>
                            </t>
                        </div>

                        <!-- Returns: back to stock, directly or through repair -->
                        <div t-if="hasReturnFlow(wh)" class="sq-sf-return">
                            <div class="sq-sf-section-title">Retour</div>
                            <div class="sq-sf-row">
                                <t t-foreach="wh.returns" t-as="step" t-key="step.type_id">
                                    <t t-set="variant" t-value="'return'"/>
                                    <t t-call="serviq_logistics.StockFlowCard"/>
                                </t>
                                <t t-if="wh.repair">
                                    <div t-if="wh.returns.length" class="sq-sf-arrow sq-sf-arrow-back" aria-hidden="true">
                                        <span class="sq-sf-arrow-label">defect</span>
                                        <i class="fa fa-long-arrow-right"/>
                                    </div>
                                    <t t-set="step" t-value="wh.repair"/>
                                    <t t-set="variant" t-value="'return'"/>
                                    <t t-call="serviq_logistics.StockFlowCard"/>
                                </t>
                                <t t-if="wh.repair_putaway">
                                    <div class="sq-sf-arrow sq-sf-arrow-back" aria-hidden="true">
                                        <span class="sq-sf-arrow-label">hersteld</span>
                                        <i class="fa fa-long-arrow-right"/>
                                    </div>
                                    <t t-set="step" t-value="wh.repair_putaway"/>
                                    <t t-set="variant" t-value="'return'"/>
                                    <t t-call="serviq_logistics.StockFlowCard"/>
                                    <div class="sq-sf-arrow sq-sf-arrow-back" aria-hidden="true">
                                        <i class="fa fa-long-arrow-up"/>
                                        <span class="sq-sf-arrow-label">naar voorraad</span>
                                    </div>
                                </t>
                            </div>
                            <div t-if="wh.returns.length" class="sq-sf-direct">
                                <i class="fa fa-reply me-1"/>
                                Direct terugnemen via <b t-esc="wh.direct_return_to"/> naar de voorraad.
                                <t t-if="wh.repair"> Defect: via reparatie<t t-if="wh.repair_putaway"> en <t t-esc="wh.repair_putaway.name"/></t>.</t>
                            </div>
                        </div>

                        <!-- Every other operation type of the warehouse -->
                        <div t-if="wh.others.length" class="sq-sf-others">
                            <div class="sq-sf-section-title text-muted">Overige bewerkingen</div>
                            <div class="sq-sf-row">
                                <t t-foreach="wh.others" t-as="step" t-key="step.type_id">
                                    <t t-set="variant" t-value="'other'"/>
                                    <t t-call="serviq_logistics.StockFlowCard"/>
                                </t>
                            </div>
                        </div>
                    </section>
                    <div t-if="state.noAccess" class="text-muted p-4">
                        Je hebt geen toegang tot de Voorraadstroom. Vraag een beheerder om het aan te vinken op je gebruiker.
                    </div>
                    <div t-elif="!state.warehouses.length" class="text-muted p-4">Geen magazijnen.</div>
                </t>
            </div>
        </div>
    </t>
</templates>
